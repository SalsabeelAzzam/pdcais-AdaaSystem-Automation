<?xml version="1.0" encoding="UTF-8"?>
<!--
  Standalone black-box UI automation suite.

  This project has no dependency on the application under test: no project
  reference, no shared library, no database driver. It is configured entirely by
  environment variables and reaches the application only over HTTP through a
  browser.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.adaa</groupId>
  <artifactId>adaa-automation</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>adaa-automation</name>
  <description>Black-box end-to-end UI automation (Playwright for Java + TestNG)</description>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- Pinned exactly: a browser-automation upgrade is a deliberate change. -->
    <playwright.version>1.47.0</playwright.version>
    <testng.version>7.10.2</testng.version>
    <slf4j.version>2.0.13</slf4j.version>
    <!-- The version Playwright already brings in; declared because the suite reads JSON with it. -->
    <gson.version>2.11.0</gson.version>

    <surefire.version>3.2.5</surefire.version>
    <compiler.plugin.version>3.13.0</compiler.plugin.version>
    <exec.plugin.version>3.2.0</exec.plugin.version>

    <!-- There is no production code here; nothing to package or install. -->
    <maven.install.skip>true</maven.install.skip>
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.microsoft.playwright</groupId>
      <artifactId>playwright</artifactId>
      <version>${playwright.version}</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.testng</groupId>
      <artifactId>testng</artifactId>
      <version>${testng.version}</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>${gson.version}</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>${slf4j.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${compiler.plugin.version}</version>
      </plugin>

      <!--
        No <suiteXmlFiles> here on purpose. Surefire ignores -Dgroups when a suite
        file is configured, and `-Dgroups=smoke` is the documented way to run the
        fast set. testng.xml is still available through the `suite` profile below.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${surefire.version}</version>
        <configuration>
          <includes>
            <include>**/*Tests.java</include>
          </includes>
          <trimStackTrace>false</trimStackTrace>
          <!-- A failing browser test must not stop the rest of the run. -->
          <skipAfterFailureCount>0</skipAfterFailureCount>
        </configuration>
      </plugin>

      <!-- Installs the browser binaries: mvn test-compile exec:java -D exec.args="install chromium" -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>${exec.plugin.version}</version>
        <configuration>
          <mainClass>com.microsoft.playwright.CLI</mainClass>
          <classpathScope>test</classpathScope>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- ./mvnw clean test -Psuite   - runs the explicit TestNG suite definition. -->
    <profile>
      <id>suite</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <suiteXmlFiles>
                <suiteXmlFile>testng.xml</suiteXmlFile>
              </suiteXmlFiles>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
